# Copia este archivo a .env.local (local) o configúralo en Vercel. Nunca pongas valores reales aquí.
# Crear la base: turso db create quest && turso db show quest --url && turso db tokens create quest
TURSO_DATABASE_URL=libsql://tu-base-tu-org.turso.io
TURSO_AUTH_TOKEN=
# Opcional: reemplaza la contraseña por defecto del panel de moderador (/mod).
# MOD_PASSWORD=
